# Claves de un proyecto exclusivo de Cotironda (no reutilizar Viralio/TeHiceEsto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Contrato de registro: deshabilitado hasta completar configuración y seguridad.
COTIRONDA_REGISTRATION_ENABLED=false
# Ref exacta del proyecto Supabase exclusivo de Cotironda, distinta de Viralio y TeHiceEsto.
COTIRONDA_SUPABASE_PROJECT_REF=
COTIRONDA_SITE_ORIGIN=http://localhost:3000
# No usar DATABASE_URL ni service_role: el registro usa el JWT Supabase/PostgREST.

# Leer rondas/ofertas auténticas SOLO en Vercel Preview, DESPUÉS de backup DEV #175.
# No activar en producción: requiere SQL D025, D060, MVP-014 y QA de permisos.
COTIRONDA_ROUNDS_READ_ENABLED=false
COTIRONDA_QUOTES_READ_ENABLED=false

# MVP-015. POST solicitud real desactivado hasta backup/restauración auténticos DEV (#175)
# Sólo Vercel Preview con la RPC D064 instalada y auditada.
COTIRONDA_ROUNDS_CREATE_ENABLED=false

# MVP-026: supplier Preview login WITHOUT general company registration.
# When the pilot is authorized: COTIRONDA_AUTH_PREVIEW_ENABLED=true,
# VERCEL_GIT_COMMIT_REF=integration/mvp-piloto-20261031 (Vercel-managed).
# COTIRONDA_REGISTRATION_ENABLED MUST remain false. No general signup.
COTIRONDA_AUTH_PREVIEW_ENABLED=false

# MVP-025: one-tap supplier WhatsApp onboarding, Preview ONLY.
# OFF until DEV authentic backup/restore (#175) and D072 migration verified.
# Server-only; values are never prefixed NEXT_PUBLIC_. No actual numbers here.
COTIRONDA_SUPPLIER_WA_UI_ENABLED=false
COTIRONDA_SUPPLIER_WA_CHANNEL=
COTIRONDA_SUPPLIER_WA_BOT_NUMBER=

# MVP-048: receptor Whapi HTTPS Preview, SIEMPRE OFF sin gateway PostgreSQL privado
# No activar antes del respaldo DEV+restore #175 y prueba real autorizada.
# Los secretos son server-only. Nunca NEXT_PUBLIC_, nunca en GitHub/Whapi logs.
# Incluso con los flags activados la ruta responde 503 hasta conectar
# un operador privado D030/D074; no usar service_role ni una RPC public.
COTIRONDA_WHAPI_WEBHOOK_ENABLED=false
COTIRONDA_WHAPI_PILOT_AUTHORIZED=false
COTIRONDA_WHAPI_CHANNEL=
COTIRONDA_WHAPI_WEBHOOK_SECRET=
COTIRONDA_WHAPI_HMAC_ID_HEX=
COTIRONDA_WHAPI_HMAC_FINGERPRINT_HEX=
COTIRONDA_WHAPI_AES_CONTENT_HEX=
COTIRONDA_WHAPI_AES_KEY_ID=aes_2026_a
