# Claves de un proyecto exclusivo de Cotironda (no reutilizar Viralio/TeHiceEsto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Contrato de registro: deshabilitado hasta completar configuración y seguridad.
COTIRONDA_REGISTRATION_ENABLED=false
# Ref exacta del proyecto Supabase exclusivo de Cotironda, distinta de Viralio y TeHiceEsto.
COTIRONDA_SUPABASE_PROJECT_REF=
COTIRONDA_SITE_ORIGIN=http://localhost:3000
# No usar DATABASE_URL ni service_role: el registro usa el JWT Supabase/PostgREST.
